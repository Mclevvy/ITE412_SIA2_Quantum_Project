{
  "info": {
    "name": "Bunius-Sense API",
    "description": "Postman collection for the Batches and Readings REST modules of the Bunius-Sense (Bignay Wine Fermentation Monitoring) system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Batches Module",
      "item": [
        {
          "name": "Case 1: GET /batches -> Success 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/batches", "host": ["{{baseUrl}}"], "path": ["batches"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Case 2: POST /batches -> Returns new batch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wineType\": \"Bignay Dry\",\n  \"startDate\": \"2026-09-22\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/batches", "host": ["{{baseUrl}}"], "path": ["batches"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has an id', function () { pm.expect(pm.response.json()).to.have.property('id'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Readings Module",
      "item": [
        {
          "name": "Case 1: GET /readings -> Success 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/readings", "host": ["{{baseUrl}}"], "path": ["readings"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Case 2: POST /readings -> Returns new reading",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": 1,\n  \"temperature\": 29.1,\n  \"ph\": 3.7,\n  \"brix\": 11.5\n}"
            },
            "url": { "raw": "{{baseUrl}}/readings", "host": ["{{baseUrl}}"], "path": ["readings"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has an id', function () { pm.expect(pm.response.json()).to.have.property('id'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
